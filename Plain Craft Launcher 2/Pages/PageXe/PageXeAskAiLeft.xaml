<local:MyPageLeft x:Class="PCL.PageXeAskAiLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  x:Name="PanBack" Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <local:MyScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="20,0,10,0">
            <StackPanel x:Name="PanSide" Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource Xe.Ai.Left.Title}" FontSize="20" Margin="0,0,0,12"
                           Foreground="{DynamicResource ColorBrush3}" />

                <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Xe.Ai.Left.Status}">
                    <StackPanel Margin="21,36,21,12">
                        <local:MyListItem x:Name="ItemStatus" Height="40" IsHitTestVisible="False"
                                          SvgIcon="lucide/info" />
                        <local:MyListItem x:Name="ItemModel" Height="40" IsHitTestVisible="False"
                                          SvgIcon="lucide/sparkles" />
                        <local:MyListItem x:Name="ItemTarget" Height="40" IsHitTestVisible="False"
                                          SvgIcon="lucide/server" />
                    </StackPanel>
                </local:MyCard>

                <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Xe.Ai.Left.Examples}">
                    <StackPanel Margin="21,36,21,15">
                        <local:MyButton x:Name="BtnExample1" Height="32" Margin="0,0,0,8"
                                        Text="{DynamicResource Xe.Ai.Example1}" />
                        <local:MyButton x:Name="BtnExample2" Height="32" Margin="0,0,0,8"
                                        Text="{DynamicResource Xe.Ai.Example2}" />
                        <local:MyButton x:Name="BtnExample3" Height="32" Margin="0,0,0,8"
                                        Text="{DynamicResource Xe.Ai.Example3}" />
                        <local:MyButton x:Name="BtnExample4" Height="32"
                                        Text="{DynamicResource Xe.Ai.Example4}" />
                    </StackPanel>
                </local:MyCard>

                <local:MyHint Theme="Blue" Text="{DynamicResource Xe.Ai.Config.Hint}" />
            </StackPanel>
        </local:MyScrollViewer>
    </Grid>
</local:MyPageLeft>
