<local:MyPageLeft x:Class="PCL.PageXeModManagerLeft"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:PCL"
                  x:Name="PanBack" Width="300"
                  AnimatedControl="{Binding ElementName=PanSide, Mode=OneWay}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <local:MyScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="20,0,10,0">
            <StackPanel x:Name="PanSide" Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource Xe.Mods.Left.Title}" FontSize="20" Margin="0,0,0,12"
                           Foreground="{DynamicResource ColorBrush3}" />

                <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Xe.Mods.Left.Target}">
                    <StackPanel Margin="21,36,21,15">
                        <TextBlock Text="{DynamicResource Xe.Mods.Left.Target}" Margin="0,0,0,5"
                                   Foreground="{DynamicResource ColorBrushGray5}" />
                        <local:MyComboBox x:Name="ComboMode" SelectionChanged="ComboMode_SelectionChanged">
                            <local:MyComboBoxItem Content="{DynamicResource Xe.Mods.Mode.Client}" />
                            <local:MyComboBoxItem Content="{DynamicResource Xe.Mods.Mode.Server}" />
                            <local:MyComboBoxItem Content="{DynamicResource Xe.Mods.Mode.Netease}" />
                        </local:MyComboBox>
                        <TextBlock Text="{DynamicResource Xe.Mods.Select.Instance}" Margin="0,12,0,5"
                                   Foreground="{DynamicResource ColorBrushGray5}" />
                        <local:MyComboBox x:Name="ComboInstance" SelectionChanged="ComboInstance_SelectionChanged" />
                    </StackPanel>
                </local:MyCard>

                <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Xe.Mods.Left.Summary}">
                    <StackPanel Margin="21,36,21,12">
                        <local:MyListItem x:Name="ItemTotal" Height="40" IsHitTestVisible="False"
                                          SvgIcon="lucide/package" />
                        <local:MyListItem x:Name="ItemEnabled" Height="40" IsHitTestVisible="False"
                                          SvgIcon="lucide/circle-check" />
                        <local:MyListItem x:Name="ItemTarget" Height="40" IsHitTestVisible="False"
                                          SvgIcon="lucide/server" />
                    </StackPanel>
                </local:MyCard>

                <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Xe.Mods.Left.Actions}">
                    <StackPanel Margin="21,36,21,15">
                        <local:MyButton x:Name="BtnRefresh" Height="34" Margin="0,0,0,8"
                                        Text="{DynamicResource Xe.Mods.Btn.Refresh}" Click="BtnRefresh_Click" />
                        <local:MyButton x:Name="BtnOpenFolder" Height="34" Margin="0,0,0,8"
                                        Text="{DynamicResource Xe.Mods.Btn.OpenFolder}" Click="BtnOpenFolder_Click" />
                        <local:MyButton x:Name="BtnGoDownload" Height="34"
                                        Text="{DynamicResource Xe.Mods.Btn.GoDownload}" Click="BtnGoDownload_Click" />
                    </StackPanel>
                </local:MyCard>

                <local:MyHint Theme="Blue" Text="{DynamicResource Xe.Mods.Right.RuleBody}" />
            </StackPanel>
        </local:MyScrollViewer>
    </Grid>
</local:MyPageLeft>
