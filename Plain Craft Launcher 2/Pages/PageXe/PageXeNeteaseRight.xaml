<local:MyPageRight x:Class="PCL.PageXeNeteaseRight"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="clr-namespace:PCL">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="25,10">
            <local:MyHint Margin="0,15" Theme="Blue"
                          Text="{DynamicResource Xe.Netease.Right.NoticeBody}" />

            <local:MyHint x:Name="HintNotChina" Margin="0,0,0,15" Theme="Yellow" Visibility="Collapsed"
                          Text="{DynamicResource Xe.Netease.NotChinaEdition}" />

            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Xe.Netease.Right.DetectedTitle}">
                <StackPanel Margin="21,36,21,14">
                    <StackPanel x:Name="PanCandidates" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <local:MyButton x:Name="BtnRefresh" Height="32" MinWidth="130" Padding="13,0"
                                        Text="{DynamicResource Xe.Netease.Btn.Refresh}" />
                        <local:MyButton x:Name="BtnLaunch" Height="32" MinWidth="150" Padding="13,0" Margin="10,0,0,0"
                                        ColorType="Highlight" Text="{DynamicResource Xe.Netease.Btn.Launch}" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Xe.Netease.Diag.Title}">
                <StackPanel Margin="21,36,21,15">
                    <TextBlock x:Name="LabDiagStatus" TextWrapping="Wrap" FontSize="13"
                               Foreground="{DynamicResource ColorBrush1}" />
                    <TextBlock x:Name="LabDiagDetail" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray5}" Visibility="Collapsed" />
                    <TextBlock x:Name="LabDiagLog" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12"
                               Foreground="{DynamicResource ColorBrushGray5}" />
                    <StackPanel x:Name="PanDiagnostics" Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="Collapsed">
                        <local:MyButton x:Name="BtnCopyReport" Height="30" MinWidth="120" Padding="10,0"
                                        Text="{DynamicResource Xe.Netease.Btn.CopyReport}" />
                        <local:MyButton x:Name="BtnOpenLog" Height="30" MinWidth="110" Padding="10,0" Margin="8,0,0,0"
                                        Text="{DynamicResource Xe.Netease.Btn.OpenLog}" />
                        <local:MyButton x:Name="BtnOpenLogFolder" Height="30" MinWidth="140" Padding="10,0"
                                        Margin="8,0,0,0" Text="{DynamicResource Xe.Netease.Btn.OpenLogFolder}" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Xe.Netease.Right.ConfigTitle}">
                <StackPanel Margin="21,36,21,15">
                    <TextBlock Text="{DynamicResource Xe.Netease.McDir.Label}" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MyTextBox x:Name="TextMcDir" Grid.Column="0" Height="30"
                                         HintText="{DynamicResource Xe.Netease.McDir.Hint}"
                                         LostFocus="Config_LostFocus" />
                        <local:MyButton x:Name="BtnBrowseDir" Grid.Column="1" Height="30" MinWidth="90" Margin="8,0,0,0"
                                        Padding="10,0" Text="{DynamicResource Xe.Netease.Btn.BrowseDir}" />
                    </Grid>

                    <TextBlock Text="{DynamicResource Xe.Netease.Version.Label}" Margin="0,10,0,4" />
                    <local:MyTextBox x:Name="TextVersion" Height="30"
                                     HintText="{DynamicResource Xe.Netease.Version.Hint}"
                                     LostFocus="Config_LostFocus" />

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <local:MyButton x:Name="BtnSave" Height="32" MinWidth="130" Padding="13,0"
                                        Text="{DynamicResource Xe.Ai.Config.Save}" />
                        <local:MyButton x:Name="BtnOpenFolder" Height="32" MinWidth="150" Padding="13,0" Margin="10,0,0,0"
                                        Text="{DynamicResource Xe.Netease.Btn.OpenFolder}" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="{DynamicResource Xe.Netease.Right.VersionsTitle}">
                <StackPanel Margin="21,36,21,15" x:Name="PanVersions" />
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
